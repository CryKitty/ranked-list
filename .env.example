NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAWG_API_KEY=

# Optional Google Drive sync. Enable the Drive API and configure an OAuth web client.
# Register <origin>/api/drive/callback for every allowed origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a long random secret (for example, openssl rand -hex 32).
DRIVE_COOKIE_SECRET=
# Comma-separated exact origins, without trailing slashes. HTTPS or loopback HTTP.
DRIVE_ALLOWED_ORIGINS=
# Optional verified Google email for the owner fallback on legacy Drive share links.
SHARE_LEGACY_OWNER_EMAIL=
